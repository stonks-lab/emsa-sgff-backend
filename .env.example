# Variables de entorno de emsa-sgff-backend.
# Copia este archivo a .env (ignorado por git) y completa los valores reales.
# Nunca subas .env al repositorio.

# ── SQL Server principal ─────────────────────────────────────────────────────
SQL_SERVER=<ip-o-hostname>            # p. ej. 10.0.0.10 o 10.0.0.10,1433
SQL_DATABASE=<nombre-base-de-datos>
SQL_AUTH=sql                          # sql | windows (Trusted_Connection)
SQL_USER=<usuario-principal>          # no se usa con SQL_AUTH=windows
SQL_PASSWORD=<contraseña-principal>

# ── SQL Server BI (lectura de avance/PAI; mismo servidor que SQL_SERVER) ─────
SQL_BI_USER=<usuario-lectura-avance-pai>
SQL_BI_PASSWORD=<contraseña-lectura-avance-pai>
SQL_BI_DATABASE=BI_dev                # opcional; por defecto BI_dev

# ── Autenticación ────────────────────────────────────────────────────────────
# Clave para firmar los JWT. Usa un valor largo y aleatorio: openssl rand -hex 32
# Si se omite, el código usa un valor por defecto inseguro (ver docs/BACKLOG.md).
JWT_SECRET=<clave-aleatoria>

# ── Monday.com ───────────────────────────────────────────────────────────────
# Token personal: Perfil → Developers → My access tokens.
# Sin estas variables, /api/monday/* responde 503.
MONDAY_API_KEY=<token-monday>
MONDAY_BOARD_ID=<id-tablero-modificaciones>   # número de la URL del tablero
